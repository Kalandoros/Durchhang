          "data": {
            "text/plain": ""
          }
        }
      ],
      "console": [
        {
          "type": "stream",
          "name": "stdout",
          "text": "F_G = 11.3 N/m,  F_W = 24.544 N/m\nsigma_0 = 15.0 N/mm\u00b2,  L = 20.0 m\n",
          "mimetype": "text/plain"
        }
      ]
    },
    {
      "id": "lEQa",
      "code_hash": "6ec9e734c9a86c1caa8c2fb0bbd26581",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"1-windeinfluss\">1. Windeinfluss</h2>\n<span class=\"paragraph\">Die resultierende Last <marimo-tex class=\"arithmatex\">||(F_{ges}||)</marimo-tex> aus Eigengewicht und Windlast nach Pythagoras.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "PKri",
      "code_hash": "8e004ecddd94a5d03d64ce54176a511e",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><marimo-tex class=\"arithmatex\">||[F_{ges} = \\sqrt{F_{G}^2 + F_{W}^2} = \\sqrt{11.3^2 + 24.544^2} = 27.020 \\; \\text{N/m}||]</marimo-tex></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "Xref",
      "code_hash": "dd914738b8a3a3f6f0b7e63e8a312369",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"2-ausschwingwinkel\">2. Ausschwingwinkel</h2>\n<span class=\"paragraph\">Der Winkel <marimo-tex class=\"arithmatex\">||(\\alpha||)</marimo-tex>, um den der Leiter durch den Wind ausgeschlagen wird.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "SFPL",
      "code_hash": "a6edbcfc566f4cd818dedb2fa03ea9b1",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><marimo-tex class=\"arithmatex\">||[\\alpha = \\arctan\\left(\\frac{F_{G}}{F_{W}}\\right) = \\arctan\\left(\\frac{11.3}{24.544}\\right) = 24.72^\\circ||]</marimo-tex></span>"
          }
        }
      ],
      "console": []
    },
